# ── Database ──────────────────────────────────────────
# Local development (SQLite — no setup needed)
DATABASE_URL=sqlite:///./data/crop_prices.db

# Production (PostgreSQL / Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Data Sources ──────────────────────────────────────
AGMARKNET_BASE_URL=https://agmarknet.gov.in
DATA_GOV_IN_API_KEY=your_api_key_here
DATA_GOV_IN_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24

# ── MLflow ────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlruns

# ── App ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Storage Layer (Azure Blob Storage / Local) ────────
DATA_SOURCE=azure
AZURE_STORAGE_ACCOUNT=yourstorageaccountname
AZURE_BLOB_BASE_URL=https://yourstorageaccountname.blob.core.windows.net/crops-data
AZURE_SAS_TOKEN=sp=rl&st=...&se=...&spr=https&sv=...&sr=c&sig=...
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

AZURE_YEAR_START=2016
AZURE_YEAR_END=2026
